DATABASE_URL="postgresql://aicorta:aicorta_dev@localhost:5432/aicorta?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_VERSION="1.0"

# Opcional: geocodificação de endereços no painel. Chave restrita ao Geocoding API do Google.
# Sem a chave, o estabelecimento pode posicionar o pin manualmente no mapa ou usar a localização do dispositivo.
# GOOGLE_GEOCODING_API_KEY=""

# Envio do formulário público de contato: endereço que recebe os leads do AICorta.
# Configure no ambiente da API (servidor), nunca como NEXT_PUBLIC.
CONTACT_TO_EMAIL="contato@seudominio.com.br"
# O envio utiliza SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD e SMTP_FROM
# configurados abaixo para recuperação de senha.

# Antigas variáveis opcionais de atendimento via link, não necessárias ao formulário:
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# Credenciais para executar manualmente: pnpm --filter @aicorta/api system:create
SYSTEM_NAME=""
SYSTEM_USERNAME=""
SYSTEM_EMAIL=""
SYSTEM_WHATSAPP=""
SYSTEM_PASSWORD=""

# Auth 1.1: SMTP para recuperação de senha (opcional em desenvolvimento)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
