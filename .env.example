DATABASE_URL="postgresql://aicorta:aicorta_dev@localhost:5432/aicorta?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_VERSION="1.0"

# Contato público (opcional): configure valores reais e refaça o build do frontend
# NEXT_PUBLIC_SUPPORT_EMAIL=""
# NEXT_PUBLIC_SUPPORT_WHATSAPP="" # Somente dígitos com DDI e DDD, ex: 5531999999999

# Credenciais para executar manualmente: pnpm --filter @aicorta/api system:create
# SYSTEM_NAME=""
# SYSTEM_USERNAME=""
# SYSTEM_EMAIL=""
# SYSTEM_WHATSAPP=""
# SYSTEM_PASSWORD=""

# Auth 1.1: SMTP para recuperação de senha (opcional em desenvolvimento)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
