# Copie como .env no diretorio raiz do projeto no servidor.
# Nunca envie .env real para o GitHub. Use senhas e valores exclusivos da homologacao.
NODE_ENV="production"
DATABASE_URL="postgresql://USUARIO:SENHA_FORTE@127.0.0.1:5432/aicorta_homolog?schema=public"
JWT_SECRET="PREENCHA_COM_CHAVE_ALEATORIA_DE_64_CARACTERES_OU_MAIS"
WEB_ORIGIN="https://www.aicorta.com.br"
NEXT_PUBLIC_API_URL="https://api.aicorta.com.br/api"
# Acesso privado da web à API, sem depender de DNS/proxy público (favicon e metadata).
INTERNAL_API_URL="http://127.0.0.1:3001/api"
NEXT_PUBLIC_APP_VERSION="homolog"
API_HOST="127.0.0.1"
API_PORT=3001
WEB_HOST="127.0.0.1"
WEB_PORT=3000

# Formulario /contato e recuperacao de senha:
CONTACT_TO_EMAIL="SEU_EMAIL_DESTINATARIO"
SMTP_HOST="SMTP_DO_PROVEDOR"
SMTP_PORT=587
SMTP_USER="USUARIO_SMTP"
SMTP_PASSWORD="SENHA_SMTP"
SMTP_FROM="AICorta <USUARIO_SMTP>"

# Opcional: localizar o endereco no mapa pelo Google Geocoding.
# GOOGLE_GEOCODING_API_KEY=""

# Configure temporariamente para o primeiro usuario SYSTEM, se necessario.
# SYSTEM_NAME=""
# SYSTEM_USERNAME=""
# SYSTEM_EMAIL=""
# SYSTEM_WHATSAPP=""
# SYSTEM_PASSWORD=""
