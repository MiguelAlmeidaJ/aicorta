generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  SYSTEM
}

enum TenantRole {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  username           String             @unique
  email              String             @unique
  whatsapp           String             @unique
  passwordHash       String
  avatar             Bytes?
  avatarMime         String?
  globalRole         GlobalRole         @default(USER)
  isActive           Boolean            @default(true)
  sessions           AuthSession[]
  issuedInvitations  TenantInvitation[] @relation("InvitationIssuer")
  issuedOwnerInvites OwnerInvite[]      @relation("OwnerInviteIssuer")
  passwordResets     PasswordReset[]
  passwordChangedAt  DateTime?
  memberships        Membership[]
  ownedTenants       Tenant[]           @relation("TenantOwner")
  clientBookings     Appointment[]      @relation("BookingClient")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  timezone            String               @default("America/Sao_Paulo")
  billingDueDay       Int                  @default(10)
  status              TenantStatus         @default(ACTIVE)
  city                String?
  state               String?
  neighborhood        String?
  cover               Bytes?
  coverMime           String?
  ownerId             String               @db.Uuid
  owner               User                 @relation("TenantOwner", fields: [ownerId], references: [id])
  memberships         Membership[]
  invitations         TenantInvitation[]
  workWindows         WorkWindow[]
  timeOffs            TimeOff[]
  services            Service[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([ownerId])
}

model Membership {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  tenantId         String            @db.Uuid
  role             TenantRole
  isActive         Boolean           @default(true)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services         EmployeeService[]
  workWindows      WorkWindow[]
  timeOffs         TimeOff[]
  employeeBookings Appointment[]     @relation("BookingEmployee")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, role])
}

model Service {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  name                String
  description         String?
  durationMinutes     Int
  priceCents          Int
  image               Bytes?
  imageMime           String?
  isActive            Boolean              @default(true)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees           EmployeeService[]
  appointments        Appointment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointmentServices AppointmentService[]

  @@unique([id, tenantId])
  @@index([tenantId, isActive])
}

model EmployeeService {
  membershipId String     @db.Uuid
  serviceId    String     @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceId])
}

model Appointment {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  serviceId            String               @db.Uuid
  employeeMembershipId String               @db.Uuid
  clientId             String               @db.Uuid
  startsAt             DateTime
  endsAt               DateTime
  status               AppointmentStatus    @default(PENDING)
  priceCents           Int
  notes                String?
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service              Service              @relation(fields: [serviceId, tenantId], references: [id, tenantId])
  services             AppointmentService[]
  employee             Membership           @relation("BookingEmployee", fields: [employeeMembershipId, tenantId], references: [id, tenantId])
  client               User                 @relation("BookingClient", fields: [clientId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantId, startsAt])
  @@index([tenantId, employeeMembershipId, startsAt])
  @@index([clientId, startsAt])
}

model AppointmentService {
  appointmentId String      @db.Uuid
  serviceId     String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  tenantId      String?     @db.Uuid

  @@id([appointmentId, serviceId])
  @@index([serviceId])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TenantInvitation {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  issuedById String     @db.Uuid
  email      String
  role       TenantRole
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuedBy   User       @relation("InvitationIssuer", fields: [issuedById], references: [id])

  @@index([tenantId, email])
  @@index([expiresAt])
}

model WorkWindow {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  membershipId String?     @db.Uuid
  weekday      Int
  startMinute  Int
  endMinute    Int
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership? @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, membershipId, weekday])
}

model TimeOff {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  membershipId String     @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, membershipId, startsAt])
}

model OwnerInvite {
  id            String    @id @default(uuid()) @db.Uuid
  issuedById    String    @db.Uuid
  referenceName String
  billingDueDay Int
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  issuedBy      User      @relation("OwnerInviteIssuer", fields: [issuedById], references: [id])

  @@index([expiresAt])
  @@index([issuedById, createdAt])
}

model PlatformBrand {
  id                      String   @id @default("platform")
  name                    String   @default("AICorta")
  black                   String   @default("#000000")
  navy                    String   @default("#050A30")
  gold                    String   @default("#F2C225")
  silver                  String   @default("#D9D9D9")
  logo                    Bytes?
  logoMime                String?
  darkLogo                Bytes?
  darkLogoMime            String?
  favicon                 Bytes?
  faviconMime             String?
  defaultTenantCover      Bytes?
  defaultTenantCoverMime  String?
  defaultServiceImage     Bytes?
  defaultServiceImageMime String?
  defaultProfileImage     Bytes?
  defaultProfileImageMime String?
  updatedAt               DateTime @updatedAt
}
