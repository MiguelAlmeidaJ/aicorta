{
  "name": "aicorta",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @aicorta/api test",
    "test:db": "pnpm --filter @aicorta/api test:db",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:save": "pm2 save",
    "db:generate": "pnpm --filter @aicorta/api db:generate",
    "db:migrate": "pnpm --filter @aicorta/api db:migrate",
    "db:studio": "pnpm --filter @aicorta/api db:studio"
  },
  "devDependencies": {
    "pm2": "^7.1.2"
  }
}
